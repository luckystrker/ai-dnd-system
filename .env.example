# ════════════════════════════════════════════════════════════════════════════
# Шаблон окружения для TTRPG-бота. Скопируйте в .env и заполните реальные значения.
#   cp .env.example .env
# В production переменные читаются systemd из EnvironmentFile (см. deploy/),
# т.к. `eve start` НЕ загружает .env автоматически (только dev/poll-скрипты).
# ════════════════════════════════════════════════════════════════════════════

# ─── LLM (OpenAI-совместимый эндпоинт) ───────────────────────────────────────
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-your-key-here
LLM_MODEL=deepseek-v4-flash

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:your-bot-token
# Username бота без @ — нужен для маршрутизации @упоминаний и /-команд.
TELEGRAM_BOT_USERNAME=my_bot
# Секретный токен для webhook'а: Telegram шлёт его в заголовке
# X-Telegram-Bot-Api-Secret-Token, бот сверяет с этим значением (401 при несовпадении).
# Используется и при setWebhook, и в poll-режиме. Сгенерируйте случайную строку.
TELEGRAM_WEBHOOK_SECRET_TOKEN=your-webhook-secret
# Для групп: выключите privacy mode в BotFather (/setprivacy -> Disable) или
# сделайте бота админом группы — иначе бот не увидит сообщения игроков,
# не адресованные ему (диалоги в транскрипт и авто-вступление не работают).

# ─── Иллюстрации сцен (Runware, опционально) ─────────────────────────────────
# Без ключа illustrate_scene тихо пропускается.
RUNWARE_API_KEY=your-runware-api-key
# RUNWARE_MODEL=runware:101@1
# RUNWARE_WIDTH=1024
# RUNWARE_HEIGHT=1024

# ─── Хранилище (опционально — значения по умолчанию указаны в коде) ──────────
# Вся память кампаний (кампании, журнал, NPC, локации, фракции, лут,
# world-state, бой) живёт в одной SQLite-базе.
# Путь к SQLite-БД (относительно рабочей директории процесса).
# CAMPAIGN_DB_PATH=data/campaigns.db

# ─── Rate limits (опционально) ───────────────────────────────────────────────
# Скользящее окно на чат/топик и на пользователя. В памяти одного процесса
# (для горизонтального масштабирования нужен общий стор, напр. Redis).
# TELEGRAM_RATE_LIMIT_CHAT_PER_MIN=20
# TELEGRAM_RATE_LIMIT_USER_PER_MIN=10
# Макс. размер входящего update (байт); 413 при превышении.
# TELEGRAM_MAX_UPDATE_BYTES=1048576

# ─── Production (задаётся systemd/dockeр, обычно НЕ в .env) ──────────────────
# Порт и хост прослушивания eve-сервера. По умолчанию 3000 / 0.0.0.0.
# Caddy проксирует на 127.0.0.1:3000 (см. deploy/caddy/Caddyfile).
# PORT=3000
# HOST=0.0.0.0
# NITRO_PORT=3000
# NITRO_HOST=0.0.0.0
