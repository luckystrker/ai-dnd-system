# ════════════════════════════════════════════════════════════════════════════
# Шаблон окружения Go-бота (ago, long-poll). Скопируйте в .env и заполните.
#   cp .env.example .env
# В production переменные читает systemd через EnvironmentFile (см. deploy/).
# Для ручного запуска .env подгружает deploy/start-polling.sh.
# ════════════════════════════════════════════════════════════════════════════

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Провайдер: opencode-go (по умолчанию), openrouter, deepseek.
# Все — OpenAI-совместимый Chat Completions.
LLM_PROVIDER=opencode-go
LLM_API_KEY=sk-your-opencode-go-key
# Переопределить корень эндпоинта (без /chat/completions — ago допишет сам).
# По умолчанию: opencode-go — https://opencode.ai/zen/go/v1,
#               openrouter  — https://openrouter.ai/api/v1,
#               deepseek    — https://api.deepseek.com.
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# Переопределить id модели. По умолчанию:
#   opencode-go / openrouter — deepseek-v4.1-flash / deepseek/deepseek-v4.1-flash,
#   deepseek — deepseek-flash.
# LLM_MODEL=deepseek-v4.1-flash
# Ключ можно задать переменной провайдера вместо LLM_API_KEY:
# OPENROUTER_API_KEY=..., OPENCODE_API_KEY=..., DEEPSEEK_API_KEY=...
#
# OpenCode Go требует заголовок x-opencode-session; Go-бот ставит его сам
# (у каждого Telegram-чата, летописца и судьи eval своя сессия).

# ─── Лимиты хода DM (опционально) ────────────────────────────────────────────
# Фиксированное окно контекста, 16000..512000 (по умолчанию 96000); компакция
# срабатывает на 75% окна.
# CONTEXT_WINDOW_TOKENS=96000
# Дедлайн одного хода DM в секундах, 1..3600 (по умолчанию 180). Ход с
# летописцем идёт в фоне и в дедлайн не входит.
# TURN_TIMEOUT_SECONDS=180
# Бюджет токенов одного хода (по умолчанию 200000). При превышении модель
# получает просьбу свернуть сцену; после хода счётчик сбрасывается.
# TOKEN_BUDGET=200000
# Лимит раундов «модель → тулы» в одном ходу (по умолчанию 12).
# MAX_TOOL_ROUNDS=12

# ─── Закрытие дня летописцем (опционально) ───────────────────────────────────
# Свой лимит раундов «модель → тулы» у летописца (по умолчанию 24). На лимит
# DM (MAX_TOOL_ROUNDS) не влияет: закрытие дня делает больше вызовов.
# CHRONICLER_MAX_TOOL_ROUNDS=24
# Сколько пропущенных дней на старте закрывать полным летописцем:
# -1 — не догонять, 0 — по умолчанию 2.
# DAYCLOSE_BACKFILL_MAX=2
# Окно последних закрытых дней для летописца, 1..30 (по умолчанию 2).
# Старше окна — только детерминированный дайджест без LLM.
# DAYCLOSE_BACKFILL_DAYS=2

# ─── Граница сессии (опционально) ────────────────────────────────────────────
# Пауза в чате/топике, после которой начинается новая игровая сессия: маркер
# «Начало новой сессии» в блоке памяти, recap и get_game_context на этом ходу.
# 1..720 часов (по умолчанию 20).
# SESSION_GAP_HOURS=20

# ─── Telegram (обязательно) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:your-bot-token
# Username бота без @ — для @упоминаний и /команд.
TELEGRAM_BOT_USERNAME=my_bot
# Корень Bot API (по умолчанию https://api.telegram.org). Для локального
# fake Bot API / прокси.
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# Окно склейки сообщений чата, 1..60000 мс (по умолчанию 2500). Калибровка:
# go run ./cmd/eval -telegram.
# TELEGRAM_COALESCE_MS=2500
# Окно follow-up гейта: сколько после ответа DM сообщение игрока считается
# ответом боту, 1..1440 минут (по умолчанию 10).
# TELEGRAM_FOLLOW_UP_MINUTES=10
# Лимиты скользящего окна на чат/топик и на игрока в минуту (20/10).
# TELEGRAM_RATE_LIMIT_CHAT_PER_MIN=20
# TELEGRAM_RATE_LIMIT_USER_PER_MIN=10
# Макс. размер входящего update и скачиваемого вложения (байт).
# TELEGRAM_MAX_UPDATE_BYTES=1048576
# TELEGRAM_MAX_ATTACHMENT_BYTES=26214400
# Long-poll getUpdates, 1..300 секунд (по умолчанию 50).
# TELEGRAM_POLL_TIMEOUT_SECONDS=50
# Для групп: выключите privacy mode в BotFather (/setprivacy -> Disable) или
# сделайте бота админом группы — иначе он не увидит сообщения игроков, не
# адресованные ему (транскрипт и автоприсединение не работают).

# ─── Иллюстрации сцен (Runware, опционально) ─────────────────────────────────
# Без ключа illustrate_scene отвечает «генерация не настроена» и просит
# продолжать текстом.
# RUNWARE_API_KEY=your-runware-api-key
# RUNWARE_MODEL=runware:101@1
# RUNWARE_WIDTH=1024
# RUNWARE_HEIGHT=1024

# ─── Хранилище ───────────────────────────────────────────────────────────────
# Вся память кампаний, durable-inbox апдейтов и event_streams — одна SQLite.
# Путь относительно WorkingDirectory процесса (по умолчанию data/campaigns.db).
# CAMPAIGN_DB_PATH=data/campaigns.db

# ─── Eval (опционально) ──────────────────────────────────────────────────────
# Судья живого eval. Провайдер по умолчанию — opencode-go; модель
# muse-spark-1.3-contributor через Responses API. Ключ — тот же LLM_API_KEY.
# EVAL_JUDGE_PROVIDER=opencode-go
# EVAL_JUDGE_MODEL=muse-spark-1.3-contributor
