# systemd-юнит для TTRPG-бота на Go (ago, long-poll).
# Установка: deploy/setup.sh кладёт символическую ссылку в /etc/systemd/system/.
#
# Управление:
#   sudo systemctl start ai-dnd
#   sudo systemctl restart ai-dnd
#   systemctl status ai-dnd
#   journalctl -u ai-dnd -f
#

[Unit]
Description=AI D&D Telegram Bot (Go, ago)
Documentation=https://github.com/luckystrker/ai-dnd-system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-dnd
Group=ai-dnd
WorkingDirectory=/opt/ai-dnd-system

# Go-бот сам читает переменные из окружения процесса: systemd отдаёт .env.
# В .env: LLM_PROVIDER/LLM_API_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_BOT_USERNAME,
# опционально CAMPAIGN_DB_PATH и лимиты хода.
EnvironmentFile=/opt/ai-dnd-system/.env

# Long-poll встроен в бинарь: отдельный poll-процесс/webhook/Caddy не нужен.
ExecStart=/opt/ai-dnd-system/bin/ai-dnd -mode telegram

# Graceful shutdown: канал перестаёт опрашивать Telegram, дожидается идущих
# ходов до 15 с (shutdownTimeout в cmd/bot), закрывает очередь летописца и
# базу. TimeoutStopSec с запасом +10 с, иначе systemd убьёт процесс на
# середине записи в SQLite.
KillSignal=SIGTERM
TimeoutStopSec=25

Restart=on-failure
RestartSec=5s

# Харденинг. ProtectSystem=strict делает /opt только для чтения; запись
# разрешена лишь в data/ (SQLite, WAL, .skills, backups).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/opt/ai-dnd-system/data
UMask=0027

# Ограничения ресурсов (можно убрать при необходимости).
MemoryMax=1G

# Логи идут в journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-dnd

[Install]
WantedBy=multi-user.target
