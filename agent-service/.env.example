LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-your-key-here
LLM_MODEL=deepseek-v4-flash
TELEGRAM_BOT_TOKEN=123456:your-bot-token
# Для групп: выключите privacy mode в BotFather (/setprivacy -> Disable) или
# сделайте бота админом группы — иначе бот не увидит сообщения игроков,
# не адресованные ему (диалоги в транскрипт и авто-вступление не работают).
TELEGRAM_BOT_USERNAME=my_bot
TELEGRAM_WEBHOOK_SECRET_TOKEN=your-webhook-secret
